#!/bin/sh
# Install once per clone: python3 scripts/setup_commit_gate.py
# Local safeguard. GitHub API commits bypass local hooks; CI checks PR messages.
printf '\nNightRider: three mandatory commit questions:\n' >&2
printf '  1. Does it make delivering a professional ride easier or safer?\n' >&2
printf "  2. Does it make the rider's experience more dependable, transparent, or trustworthy?\n" >&2
printf '  3. Does it make the industry better?\n' >&2
printf 'If none apply: do not commit without an explicit, scoped owner MAKE IT SO instruction.\n\n' >&2

if [ -z "$1" ] || [ ! -f "$1" ]; then
  printf 'ERROR: Git did not provide a commit message file.\n' >&2
  exit 1
fi

# The description needs at least fifteen nonempty characters of explanation.
if grep -Eq '^NR-Value: (safety|customer-trust|industry) - [^[:space:]].{14,}$' "$1" ||
   grep -Eq '^NR-Override: MAKE IT SO - [^[:space:]].{14,}$' "$1"; then
  exit 0
fi

cat >&2 <<'EOF'
COMMIT BLOCKED: Explain a concrete benefit from the current three questions.
Use a full sentence (15+ characters), for example:

NR-Value: industry - Helps smaller local transportation companies compete fairly.

Allowed categories: safety, customer-trust, industry
An owner-authorized exception for this exact change may instead use:

NR-Override: MAKE IT SO - Describe the specifically approved change here.

An override requires direct product-owner permission recorded in the PR.
It never waives safety, privacy, accessibility, testing or merge checks.
See AGENTS.md for details.
EOF
exit 1
